@{
    ViewData["Title"] = "Calendar";

    int year = ViewBag.Year;
    int month = ViewBag.Month;
    DateTime firstDayOfMonth = ViewBag.FirstDayOfMonth;
    int daysInMonth = ViewBag.DaysInMonth;

    string[] dayStatuses = new string[daysInMonth + 1];
    if (ViewBag.DayStatuses != null)
    {
        dayStatuses = (string[])ViewBag.DayStatuses;
    }

    int startDay = (int)firstDayOfMonth.DayOfWeek;
    string monthName = new DateTime(year, month, 1).ToString("MMMM yyyy");

    int prevYear = year;
    int prevMonth = month - 1;
    if (month == 1)
    {
        prevMonth = 12;
        prevYear = year - 1;
    }

    int nextYear = year;
    int nextMonth = month + 1;
    if (month == 12)
    {
        nextMonth = 1;
        nextYear = year + 1;
    }
}

<h1 class="mb-4">Practice Calendar</h1>

<div class="d-flex justify-content-between align-items-center mb-3">
    <a class="btn btn-outline-primary"
       asp-action="Calendar"
       asp-route-year="@prevYear"
       asp-route-month="@prevMonth">
        Previous
    </a>

    <h3 class="m-0">@monthName</h3>

    <a class="btn btn-outline-primary"
       asp-action="Calendar"
       asp-route-year="@nextYear"
       asp-route-month="@nextMonth">
        Next
    </a>
</div>

<div class="mb-3 small">
    <span class="badge bg-success me-2">Good</span>
    <span class="badge bg-warning text-dark me-2">Okay</span>
    <span class="badge bg-danger">Bad</span>
</div>

<div class="row row-cols-7 g-2 text-center fw-bold mb-2">
    <div class="col">Sun</div>
    <div class="col">Mon</div>
    <div class="col">Tue</div>
    <div class="col">Wed</div>
    <div class="col">Thu</div>
    <div class="col">Fri</div>
    <div class="col">Sat</div>
</div>

<div class="row row-cols-7 g-2">
    @for (int i = 0; i < startDay; i++)
    {
        <div class="col">
            <div class="border rounded p-3 bg-light" style="height: 100px;"></div>
        </div>
    }

    @for (int day = 1; day <= daysInMonth; day++)
    {
        string status = dayStatuses[day];

        string bgClass = "bg-white";
        if (status == "good")
        {
            bgClass = "calendar-good";
        }
        else if (status == "okay")
        {
            bgClass = "calendar-okay";
        }
        else if (status == "bad")
        {
            bgClass = "calendar-bad";
        }

        <div class="col">
            <div class="border rounded p-3 @bgClass" style="height: 100px;">
                <strong>@day</strong>
            </div>
        </div>
    }
</div>
